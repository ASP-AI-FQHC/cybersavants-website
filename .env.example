# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.cybersavants.com

# --- Executive briefing form delivery: configure ONE (form returns "not configured" until set) ---
# Option A: Resend (https://resend.com) – verified sender domain required
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Option B: generic webhook (CRM, Zapier, Make, HubSpot form relay, etc.) – receives JSON POST
CONTACT_WEBHOOK_URL=

# --- Optional spam protection: Cloudflare Turnstile (honeypot + timing + rate limit are always on) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: scheduling link shown after form submit (e.g. Microsoft Bookings / Calendly) ---
NEXT_PUBLIC_SCHEDULING_URL=
